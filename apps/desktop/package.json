{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron desktop shell for the DeepSeek Harness web GUI: boots the web profile in-process and loads the SPA in a window",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "start": "electron lib/main.js",
    "dev": "electron lib/main.js"
  },
  "files": [
    "lib/*.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-base": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-web-app": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "electron": "^43.4.0"
  }
}
